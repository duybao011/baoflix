"use client";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";
import type { Episode, EpisodeServer, MovieDetail } from "@/lib/kkphim";
import { getNormalWatchedKey } from "@/lib/watchStore";
import { findEpisodeMatch } from "@/lib/episodeMatch";

type EpisodePickerModalProps = {
  movie: MovieDetail;
  servers: EpisodeServer[];
  safeServerIndex: number;
  safeEpisodeIndex: number;
  watchedEpisodes: string[];
  onClose: () => void;
};

type EpisodeGroup = {
  label: string;
  start: number;
  end: number;
  episodes: Episode[];
};

const EPISODE_GROUP_SIZE = 24;

function normalizeServerName(name?: string) {
  const text = String(name || "").toLowerCase();

  if (text.includes("lồng") || text.includes("long")) return "Lồng tiếng";
  if (text.includes("thuyết") || text.includes("thuyet")) return "Thuyết minh";
  if (text.includes("vietsub") || text.includes("sub")) return "Vietsub";

  return name || "Server";
}

function getEpisodeUrl(movieSlug: string, serverIndex: number, episodeIndex: number) {
  return `/xem/${movieSlug}?server=${serverIndex}&tap=${episodeIndex}`;
}

function buildEpisodeGroups(episodes: Episode[]) {
  const groups: EpisodeGroup[] = [];

  for (let start = 0; start < episodes.length; start += EPISODE_GROUP_SIZE) {
    const end = Math.min(start + EPISODE_GROUP_SIZE, episodes.length);

    groups.push({
      label: `${start + 1}-${end}`,
      start,
      end,
      episodes: episodes.slice(start, end),
    });
  }

  return groups;
}

function getInitialGroupIndex(episodeIndex: number) {
  return Math.max(0, Math.floor(episodeIndex / EPISODE_GROUP_SIZE));
}

function focusModalDefault(serverIndex: number, episodeIndex: number) {
  window.setTimeout(() => {
    const modal = document.querySelector<HTMLElement>(
      "[data-tv-modal='episode-picker']"
    );

    if (!modal) return;

    const target =
      modal.querySelector<HTMLElement>(
        `[data-tv-focus-key="episode-picker:episode:${serverIndex}:${episodeIndex}"]`
      ) ||
      modal.querySelector<HTMLElement>(
        `[data-tv-focus-key="episode-picker:server:${serverIndex}"]`
      ) ||
      modal.querySelector<HTMLElement>("[data-tv-default]") ||
      modal.querySelector<HTMLElement>("a[href], button:not([disabled])");

    if (!target) return;

    target.focus({ preventScroll: true });
    target.scrollIntoView({
      behavior: "auto",
      block: "center",
      inline: "center",
    });
  }, 80);
}

export default function EpisodePickerModal({
  movie,
  servers,
  safeServerIndex,
  safeEpisodeIndex,
  watchedEpisodes,
  onClose,
}: EpisodePickerModalProps) {
  const validServerIndexes = useMemo(() => {
    return servers
      .map((server, serverIndex) => ({ server, serverIndex }))
      .filter((item) => (item.server.server_data ?? []).length > 0);
  }, [servers]);

  const initialServerIndex = validServerIndexes.some(
    (item) => item.serverIndex === safeServerIndex
  )
    ? safeServerIndex
    : validServerIndexes[0]?.serverIndex ?? 0;

  const [selectedServerIndex, setSelectedServerIndex] =
    useState(initialServerIndex);

  const [activeGroupByServer, setActiveGroupByServer] = useState<
    Record<number, number>
  >(() => ({
    [initialServerIndex]: getInitialGroupIndex(safeEpisodeIndex),
  }));

  const selectedServer = servers[selectedServerIndex];
  const selectedEpisodes = selectedServer?.server_data ?? [];
  const currentEpisode =
    servers[safeServerIndex]?.server_data?.[safeEpisodeIndex];

  const selectedEpisodeMatch = useMemo(() => {
    return findEpisodeMatch(currentEpisode, selectedEpisodes, safeEpisodeIndex);
  }, [currentEpisode, selectedEpisodes, safeEpisodeIndex]);

  const selectedMatchingEpisodeIndex = selectedEpisodeMatch.index;

  const groups = useMemo(() => {
    return buildEpisodeGroups(selectedEpisodes);
  }, [selectedEpisodes]);

  const activeGroupIndex = Math.min(
    Math.max(activeGroupByServer[selectedServerIndex] ?? 0, 0),
    Math.max(groups.length - 1, 0)
  );

  const activeGroup = groups[activeGroupIndex];
  const currentEpisodeExistsInSelectedServer =
    selectedEpisodeMatch.matched &&
    selectedMatchingEpisodeIndex >= 0 &&
    Boolean(selectedEpisodes[selectedMatchingEpisodeIndex]);

  useEffect(() => {
    focusModalDefault(safeServerIndex, safeEpisodeIndex);
  }, [safeServerIndex, safeEpisodeIndex]);

  function selectServer(serverIndex: number) {
    setSelectedServerIndex(serverIndex);

    setActiveGroupByServer((old) => {
      if (old[serverIndex] !== undefined) return old;

      const targetEpisodes = servers[serverIndex]?.server_data ?? [];
      const targetMatch = findEpisodeMatch(
        currentEpisode,
        targetEpisodes,
        safeEpisodeIndex
      );
      const initialGroup = getInitialGroupIndex(Math.max(targetMatch.index, 0));

      return {
        ...old,
        [serverIndex]: initialGroup,
      };
    });
  }

  return (
    <div
      data-tv-scope="episode-panel"
      data-tv-lock="true"
      data-tv-modal="episode-picker"
      className="fixed inset-0 z-[120] flex items-end justify-center overflow-hidden bg-black/75 p-0 backdrop-blur-sm md:items-center md:p-6"
    >
      <section className="flex max-h-[92dvh] w-full max-w-6xl flex-col overflow-hidden rounded-t-3xl border border-white/10 bg-[#0b0f19] shadow-2xl md:max-h-[86dvh] md:rounded-3xl">
        <div className="shrink-0 border-b border-white/10 p-5">
          <div className="flex items-start justify-between gap-4">
            <div className="min-w-0">
              <p className="text-xs font-black uppercase tracking-[0.2em] text-yellow-300">
                Tập / nguồn
              </p>

              <h2 className="mt-1 line-clamp-1 text-2xl font-black text-white">
                {movie.name}
              </h2>

              <p className="mt-1 text-sm text-slate-400">
                Chọn phiên bản trước, rồi chọn tập muốn xem.
              </p>
            </div>

            <button
              type="button"
              data-tv-close
              onClick={onClose}
              className="shrink-0 rounded-2xl border border-white/10 bg-white/5 px-5 py-3 font-bold hover:bg-white/10"
            >
              Đóng
            </button>
          </div>
        </div>

        <div
          className="baoflix-scrollbar min-h-0 flex-1 overflow-y-auto overscroll-contain p-5"
          style={{ WebkitOverflowScrolling: "touch" }}
        >
          <div className="mb-6 rounded-3xl border border-white/10 bg-white/[0.035] p-4">
            <div className="mb-3 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 className="text-lg font-black text-white">Phiên bản</h3>
                <p className="mt-1 text-sm text-slate-400">
                  Phiên bản đang chọn: {normalizeServerName(selectedServer?.server_name)}
                </p>
              </div>

              <div className="flex flex-wrap gap-2">
                {selectedEpisodes.length > 0 && (
                  <Link
                    href={getEpisodeUrl(movie.slug, selectedServerIndex, 0)}
                    onClick={onClose}
                    className="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-bold hover:bg-white/10"
                  >
                    Tập đầu
                  </Link>
                )}

                {selectedEpisodes.length > 1 && (
                  <Link
                    href={getEpisodeUrl(
                      movie.slug,
                      selectedServerIndex,
                      selectedEpisodes.length - 1
                    )}
                    onClick={onClose}
                    className="rounded-xl bg-red-600 px-4 py-2 text-sm font-bold hover:bg-red-500"
                  >
                    Tập mới nhất
                  </Link>
                )}
              </div>
            </div>

            <div data-tv-row className="flex flex-wrap gap-2">
              {validServerIndexes.map((item) => {
                const serverEpisodes = item.server.server_data ?? [];
                const active = item.serverIndex === selectedServerIndex;
                const serverEpisodeMatch = findEpisodeMatch(
                  currentEpisode,
                  serverEpisodes,
                  safeEpisodeIndex
                );
                const watchedCurrent =
                  serverEpisodeMatch.matched &&
                  watchedEpisodes.includes(
                    getNormalWatchedKey(
                      movie.slug,
                      item.serverIndex,
                      serverEpisodeMatch.index
                    )
                  );

                return (
                  <button
                    key={`${item.server.server_name}-${item.serverIndex}`}
                    type="button"
                    onClick={() => selectServer(item.serverIndex)}
                    data-tv-focus-key={`episode-picker:server:${item.serverIndex}`}
                    data-tv-default={active ? true : undefined}
                    className={[
                      "rounded-xl border px-4 py-2 text-sm font-black",
                      active
                        ? "border-yellow-300 bg-yellow-300 text-black"
                        : "border-white/10 bg-white/5 text-slate-200 hover:bg-white/10",
                    ].join(" ")}
                  >
                    {watchedCurrent && !active ? "✓ " : ""}
                    {normalizeServerName(item.server.server_name)}
                    <span className="ml-1 opacity-70">({serverEpisodes.length})</span>
                  </button>
                );
              })}
            </div>
          </div>

          {currentEpisodeExistsInSelectedServer && (
            <div className="mb-6 rounded-3xl border border-yellow-300/20 bg-yellow-300/10 p-4">
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h3 className="font-black text-yellow-200">Tập đang xem</h3>
                  <p className="mt-1 text-sm text-slate-300">
                    {selectedEpisodes[selectedMatchingEpisodeIndex]?.name ||
                      `Tập ${selectedMatchingEpisodeIndex + 1}`}
                  </p>
                </div>

                <Link
                  href={getEpisodeUrl(
                    movie.slug,
                    selectedServerIndex,
                    selectedMatchingEpisodeIndex
                  )}
                  onClick={onClose}
                  className="rounded-2xl bg-yellow-300 px-5 py-3 text-sm font-black text-black hover:bg-yellow-200"
                >
                  Xem tập này ở server này
                </Link>
              </div>
            </div>
          )}

          {selectedEpisodes.length === 0 ? (
            <div className="rounded-3xl border border-white/10 bg-black/20 p-6 text-slate-400">
              Server này chưa có tập.
            </div>
          ) : (
            <div className="rounded-3xl border border-white/10 bg-white/[0.035] p-4">
              <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h3 className="text-xl font-black text-white">Danh sách tập</h3>
                  <p className="mt-1 text-sm text-slate-400">
                    {selectedEpisodes.length} tập
                    {activeGroup && groups.length > 1
                      ? ` • đang hiện ${activeGroup.start + 1}-${activeGroup.end}`
                      : ""}
                  </p>
                </div>
              </div>

              {groups.length > 1 && (
                <div data-tv-row className="mb-4 flex flex-wrap gap-2">
                  {groups.map((group, groupIndex) => {
                    const active = groupIndex === activeGroupIndex;

                    return (
                      <button
                        key={`${selectedServerIndex}-${group.label}`}
                        type="button"
                        onClick={() =>
                          setActiveGroupByServer((old) => ({
                            ...old,
                            [selectedServerIndex]: groupIndex,
                          }))
                        }
                        className={[
                          "rounded-xl border px-4 py-2 text-sm font-black",
                          active
                            ? "border-yellow-300 bg-yellow-300 text-black"
                            : "border-white/10 bg-white/5 text-slate-200 hover:bg-white/10",
                        ].join(" ")}
                      >
                        {group.label}
                      </button>
                    );
                  })}
                </div>
              )}

              <div
                data-tv-row
                className="grid grid-cols-2 gap-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8"
              >
                {(activeGroup?.episodes ?? selectedEpisodes).map(
                  (episode, localEpisodeIndex) => {
                    const episodeIndex = activeGroup
                      ? activeGroup.start + localEpisodeIndex
                      : localEpisodeIndex;

                    const active =
                      selectedEpisodeMatch.matched &&
                      episodeIndex === selectedMatchingEpisodeIndex;

                    const watched = watchedEpisodes.includes(
                      getNormalWatchedKey(movie.slug, selectedServerIndex, episodeIndex)
                    );

                    return (
                      <Link
                        key={`${selectedServerIndex}-${episode.name}-${episodeIndex}`}
                        href={getEpisodeUrl(movie.slug, selectedServerIndex, episodeIndex)}
                        data-tv-focus-key={`episode-picker:episode:${selectedServerIndex}:${episodeIndex}`}
                        data-tv-episode-current={active ? "true" : undefined}
                        data-tv-default={active ? true : undefined}
                        onClick={onClose}
                        className={[
                          "flex min-h-[54px] items-center justify-center rounded-xl border px-3 py-3 text-center text-sm font-bold",
                          active
                            ? "border-red-500 bg-red-600 text-white"
                            : "border-white/10 bg-white/5 text-slate-200 hover:bg-white/10 focus-visible:border-yellow-300 focus-visible:bg-yellow-300 focus-visible:text-black",
                        ].join(" ")}
                      >
                        <span className="inline-flex items-center justify-center gap-1">
                          {watched && <span className="text-yellow-300">✓</span>}
                          <span>{episode.name}</span>
                        </span>
                      </Link>
                    );
                  }
                )}
              </div>
            </div>
          )}

          <div data-tv-row className="mt-6 flex flex-wrap gap-3">
            <Link
              href={`/phim/${movie.slug}`}
              onClick={onClose}
              className="rounded-2xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-bold hover:bg-white/10"
            >
              Về trang chi tiết
            </Link>
          </div>

          <div className="h-6" />
        </div>
      </section>
    </div>
  );
}
